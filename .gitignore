# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Audio related files
*.sf2
*.sf3
*.pcm
*.mid

# Test fonts are fetched by `cargo xtask fetch-fonts`; the source archive
# comes from <https://github.com/beicause/beicause/tree/main/assets>. All of
# them stay ignored (the .sf2/.sf3 patterns above already cover
# FluidR3Mono_GM.sf2/.sf3 and TimGM6mb.sf2).
samples/FluidR3Mono_GM.tar.zst

# Used for tests (keep the tiny checked-in sample files visible).
!samples/dummy.sf3
!samples/test_empty_samples.sf2
